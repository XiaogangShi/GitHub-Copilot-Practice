{
  "manifest_version": 3,
  "name": "历史记录隐私查看器",
  "version": "1.0.0",
  "description": "查看浏览历史，隐藏URL，保护隐私",

  "permissions": [
    "tabs",
    "storage"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "历史记录隐私查看器"
  },

  "background": {
    "service_worker": "background.js"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
